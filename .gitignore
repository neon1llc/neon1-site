# .gitignore - Local files kept out of the repository.

# macOS folder metadata
.DS_Store

# Change list from make deploy, removed by make invalidate

# Local Node tools
node_modules/

# neon1-corpus checkout and export, from make corpus
.corpus/

# The Knowledge Center and blog, built from the newest neon1-corpus release by make content (PDFs included,
# printed in the deploy job by make knowledge-pdf). Never committed, so the repository can't drift from a release
src/app/public/knowledge/
src/app/public/blog/

# dev.neon1.tech builds, from make dev-build
.dev-build/
