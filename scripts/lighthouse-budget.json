{
  "version": 1,
  "pages": [
    { "name": "home", "path": "/" },
    { "name": "knowledge-index", "path": "/knowledge/" },
    { "name": "knowledge-document", "path": "/knowledge/engagement/capabilities/" },
    { "name": "blog-post", "path": "/blog/why-neon1/" },
    { "name": "whats-new", "path": "/knowledge/company/whats-new/" }
  ],
  "profiles": {
    "mobile": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 1800 }]
      }
    },
    "desktop": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 1800 }]
      }
    }
  },
  "notes": {
    "measurement": "Thresholds are checked against the median of repeated local Lighthouse lab runs. This is a regression budget, not a field Core Web Vitals result.",
    "coreWebVitals": "Uses web.dev good thresholds for LCP (2500 ms) and CLS (0.1). Lighthouse lab runs do not measure INP; responsiveness requires field data or interaction testing.",
    "otherMetrics": "Performance category floor and TBT are Lighthouse CI style regression assertions. FCP is a warning budget."
  }
}
