    "car": {
      "title": "Model car on the sill (full and phone cuts)",
      "origin": "third-party",
      "sources": [
        "camaro"
      ],
      "made": "Unbranded, recolored, stripped of hidden parts, collapsed to a few named materials, and optimized by blender/car_import.py (the owner's private planning folder), with a lighter cut for phones; written by glTF-Transform v4.5.1 with mesh quantization.",
      "consumers": [
        "js/white-rabbit-car.js"
      ]
    },
    "room-bake": {
      "title": "The room's baked light: second-UV geometry and occlusion maps",
      "origin": "first-party",
      "made": "Baked in Blender by blender/room.py (the owner's private planning folder) from the room js/white-rabbit-room.js builds, keyed by its mesh names (room-N, in build order); room.glb written by glTF-Transform v4.5.1. The dense chairs ship one occlusion byte per vertex (.ao) instead of a second UV map. make models checks the names, vertex counts, and bounds against the code.",
      "consumers": [
        "js/white-rabbit-scene.js"
      ]
    },
    "room-photo-maps": {
      "title": "Room materials: leather, walnut, carpet, plaster, and floor planks",
      "origin": "third-party",
      "sources": [
        "polyhaven-textures"
      ],
      "made": "Prepared for the site and converted to WebP by blender/textures.py (the owner's private planning folder). carpet-detail.webp is shipped but no script loads it at present.",
      "consumers": [
        "js/white-rabbit-room.js"
      ]
    },
    "lawn-maps": {
      "title": "Lawn color and relief",
      "origin": "third-party",
